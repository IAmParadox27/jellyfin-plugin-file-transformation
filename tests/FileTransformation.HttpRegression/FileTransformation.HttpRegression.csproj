<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <MiddlewareSource Condition="'$(MiddlewareSource)' == ''">../../src/Jellyfin.Plugin.FileTransformation/Infrastructure/FileTransformationMiddleware.cs</MiddlewareSource>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <Compile Include="$(MiddlewareSource)" Link="FileTransformationMiddleware.cs" />
        <Compile Include="../../src/Jellyfin.Plugin.FileTransformation/Library/IWebFileTransformationReadService.cs" Link="IWebFileTransformationReadService.cs" />
    </ItemGroup>
</Project>
